CURSOR_API_KEY=            # creates and drives the cloud agents
CURSOR_ADMIN_API_KEY=      # reads the team usage ledger, which is where cost comes from
GITHUB_TOKEN=              # creates private forks and pushes the harness commit
FORK_OWNER=                # GitHub user or org that holds the forks
MIGRATIONBENCH_DIR=        # clone of https://github.com/amazon-science/MigrationBench
MIGRATIONBENCH_PYTHON=     # python with MigrationBench installed, e.g. $MIGRATIONBENCH_DIR/.venv/bin/python
JAVA17_HOME=               # Temurin 17 home used by the grader
MAVEN_HOME=                # Maven 3.9.6 home used by the grader
